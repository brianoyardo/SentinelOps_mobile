# ========================================================
# N8N — ORQUESTADOR DE AUTOMATIZACIÓN
# Descomenta SOLO el bloque del ambiente que necesitas.
# ========================================================

# 🟡 DESARROLLO LOCAL (n8n corriendo en esta misma máquina)
# EXPO_PUBLIC_N8N_BASE_URL=http://localhost:5678
# EXPO_PUBLIC_N8N_ENV=test

# 🔵 RED LOCAL (n8n en otra máquina de la red interna - IP actual)
