EXPO_PUBLIC_N8N_ENV=prod

# 🟢 PRODUCCIÓN VPS (AWS - descomentar al desplegar)
# EXPO_PUBLIC_N8N_BASE_URL=https://sentinelopscatar.duckdns.org:5678
# EXPO_PUBLIC_N8N_ENV=prod

